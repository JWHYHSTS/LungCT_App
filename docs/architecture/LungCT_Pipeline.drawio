        <mxCell id="PL4-t94" value="Đứt: trao đổi qua mạng" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="PL4-F57">
          <mxGeometry x="370" y="224" width="216" height="24" as="geometry" />
        </mxCell>
        <mxCell id="PL4-N95" value="&lt;b&gt;Lời nhắc trên UI và PDF&lt;/b&gt;: kết quả AI chỉ hỗ trợ tham khảo, không thay kết luận bác sĩ. Scores là điểm mô hình chưa hiệu chuẩn, không gọi là xác suất mắc bệnh. Grad-CAM chỉ giải thích nhánh CNN, không phải đường viền khối u." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="1310" width="1600" height="150" as="geometry" />
        </mxCell>
      </root>
