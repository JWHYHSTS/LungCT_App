        <mxCell id="PL2-e21" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PL2-b12" target="PL2-b13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-L22" value="HỢP NHẤT VÀ PHÂN LOẠI — Keras" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#E0F2F1;strokeColor=#00897B;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1540" y="110" width="820" height="900" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b23" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Hai token cùng chiều 256&lt;/b&gt;: cnn_token · vit_token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L22">
          <mxGeometry x="20" y="60" width="780" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b24" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AdaptiveGate&lt;/b&gt;&lt;br&gt;α = sigmoid(MLP[cnn, vit]) mỗi mẫu&lt;br&gt;gated = α·cnn + (1 − α)·vit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L22">
          <mxGeometry x="20" y="190" width="370" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b25" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Attention trên 2 token&lt;/b&gt;&lt;br&gt;StackTokens [B, 2, 256]&lt;br&gt;MultiHeadAttention 4 head&lt;br&gt;+ Add + LayerNorm → Flatten 512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L22">
          <mxGeometry x="430" y="190" width="370" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b26" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Concatenate&lt;/b&gt;: gated 256 · cnn_token 256 · vit_token 256 · attention 512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L22">
          <mxGeometry x="20" y="390" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b27" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Dense 1024 GELU → Dropout 0.40 → Dense 512 GELU → Dropout 0.35&lt;br&gt;→ Dense 256 GELU → Dropout 0.30" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L22">
          <mxGeometry x="20" y="500" width="780" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b28" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Softmax 3 lớp&lt;/b&gt; — thứ tự cố định [0 Benign · 1 Malignant · 2 Normal]&lt;br&gt;scores là điểm mô hình, chưa hiệu chuẩn thành xác suất mắc bệnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=3;dashed=1;dashPattern=2 3;" vertex="1" parent="PL2-L22">
          <mxGeometry x="20" y="620" width="780" height="110" as="geometry" />
        </mxCell>
        <mxCell id="PL2-N29" value="Layer trong code tên “cross_attn” nhưng phép tính là attention giữa 2 token tổng hợp (CNN, ViT), KHÔNG phải cross-attention trên toàn bộ patch ảnh. Bản cũ ghi “cổng α + cross-attention” đã sửa." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="PL2-L22">
          <mxGeometry x="20" y="760" width="780" height="120" as="geometry" />
        </mxCell>
