  <diagram id="PL-p4" name="4. Luồng sử dụng trên app">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PL4-t1" value="&lt;b&gt;Trang 4 — Luồng sử dụng: chẩn đoán hỗ trợ trên ứng dụng di động (thiết kế đề xuất)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="2000" height="38" as="geometry" />
        </mxCell>
        <mxCell id="PL4-t2" value="Phân tích local chạy hoàn toàn trên điện thoại; server qua HTTPS → FastAPI → job. Hai nguồn trả cùng hợp đồng kết quả." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PL4-actor" value="Bác sĩ" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#333333;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="PL4-L3" value="ĐIỆN THOẠI — ứng dụng LungCT (Android/iOS, React Native)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="2240" height="780" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b4" value="&lt;b&gt;Đăng nhập&lt;/b&gt;&lt;br&gt;trực tuyến lần đầu, sau đó cục bộ&lt;br&gt;(file Kiến trúc, trang 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="20" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b5" value="&lt;b&gt;Bệnh nhân&lt;/b&gt;&lt;br&gt;chọn hoặc tạo hồ sơ&lt;br&gt;của chính bác sĩ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="300" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b6" value="&lt;b&gt;Tạo / mở ca&lt;/b&gt;&lt;br&gt;một ca nhiều ảnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="580" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b7" value="&lt;b&gt;Chọn / chụp ảnh&lt;/b&gt;&lt;br&gt;thư viện hoặc camera" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="860" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b8" value="&lt;b&gt;Kiểm tra ảnh&lt;/b&gt;&lt;br&gt;định dạng, dung lượng, pixel;&lt;br&gt;ảnh chụp phim: ngoài phân bố" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1140" y="60" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL4-d9" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B26A00&quot;&gt;&lt;b&gt;[CHƯA CHỐT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nguồn&lt;br&gt;phân tích?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1440" y="45" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b10" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Phân tích cục bộ&lt;/b&gt; (không cần mạng)&lt;br&gt;resize 512/224 → CLS → fusion → scores&lt;br&gt;→ Grad-CAM nhánh CNN · runtime chưa chốt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1740" y="50" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b11" value="&lt;b&gt;Kết quả từng ảnh&lt;/b&gt;&lt;br&gt;scores [Benign, Malignant, Normal] · nhãn&lt;br&gt;modelVersion · nguồn local/server · real/mock&lt;br&gt;classificationStatus, explanationStatus riêng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1740" y="250" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b12" value="&lt;b&gt;Gửi ảnh qua HTTPS&lt;/b&gt;&lt;br&gt;services/api (cần mạng)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1420" y="260" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PL4-d13" value="CAM đạt&lt;br&gt;(PASS)?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1830" y="460" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b14" value="Báo “thiếu Grad-CAM”,&lt;br&gt;giữ scores, cho thử lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1830" y="645" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b15" value="&lt;b&gt;Hiển thị&lt;/b&gt;&lt;br&gt;ảnh gốc + CAM, zoom/pan, độ mờ;&lt;br&gt;lời nhắc chỉ hỗ trợ tham khảo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1100" y="460" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b16" value="&lt;b&gt;Lưu nháp + nhận xét&lt;/b&gt;&lt;br&gt;thêm/thay ảnh trước hoàn tất;&lt;br&gt;kết quả cũ không gắn ảnh mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="760" y="460" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b17" value="&lt;b&gt;Hoàn tất ca&lt;/b&gt;&lt;br&gt;snapshot phiên bản kết quả" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="420" y="460" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b18" value="&lt;b&gt;Sau hoàn tất&lt;/b&gt;&lt;br&gt;lịch sử · thùng rác · PDF Việt/Anh&lt;br&gt;thống kê · thông báo nội dung chung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="20" y="460" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b19" value="&lt;b&gt;Lưu trữ cục bộ&lt;/b&gt;: SQLite mã hóa · ảnh/CAM/PDF trong vùng app · tách theo tài khoản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="420" y="650" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="PL4-b20" value="&lt;b&gt;Hàng đợi đồng bộ&lt;/b&gt;&lt;br&gt;gửi sau khi kiểm tra tài khoản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL4-L3">
          <mxGeometry x="1100" y="650" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="PL4-e21" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PL4-actor" target="PL4-b4">
