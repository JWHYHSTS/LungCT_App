        <mxCell id="PL2-e33" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PL2-b23" target="PL2-b25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-e34" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PL2-b24" target="PL2-b26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-e35" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PL2-b25" target="PL2-b26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-e36" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PL2-b26" target="PL2-b27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-e37" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PL2-b27" target="PL2-b28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b38" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Grad-CAM nhánh CNN&lt;/b&gt;&lt;br&gt;gradient của score lớp mục tiêu theo activation conv5_block3_out (ResNet50); CLS ViT giữ cố định → bản đồ chuẩn hóa [0,1]&lt;br&gt;Trạng thái: PASS · ZERO_CAM · UNAVAILABLE · FAIL — lỗi không được thay bằng heatmap giả&lt;br&gt;Chỉ giải thích đường CNN; không phải mask/ranh giới u; màu không so sánh tuyệt đối giữa hai ảnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="810" width="1200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="PL2-e39" value="score lớp mục tiêu" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PL2-b28" target="PL2-b38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL2-N40" value="&lt;b&gt;Huấn luyện&lt;/b&gt;: Stage A ResNet50 đóng băng; Stage B mở 60 layer cuối ResNet50 (bản cũ ghi “khối conv5” đã sửa), BatchNorm giữ đóng băng. ViT luôn đóng băng; CLS tính trước và cache theo hash ảnh. Loss 0.7 focal + 0.3 CE theo từng mẫu với class weights. Ngân sách train khác nhau giữa các mô hình: không kết luận so sánh kiến trúc công bằng." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1050" width="1450" height="130" as="geometry" />
