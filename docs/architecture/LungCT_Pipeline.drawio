        <mxCell id="PL1-L3" value="HUẤN LUYỆN — Google Colab (TensorFlow cho CNN/fusion, PyTorch cho ViT)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#E0F2F1;strokeColor=#00897B;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="2320" height="980" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B26A00&quot;&gt;&lt;b&gt;[CHƯA CHỐT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;1. Nguồn và license&lt;/b&gt;&lt;br&gt;IQ-OTH/NCCD · 3 lớp&lt;br&gt;tác giả/license chưa xác minh [SRC-01]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=8 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="30" y="60" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b5" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;2. Môi trường&lt;/b&gt;&lt;br&gt;config, environment, pip-freeze&lt;br&gt;thư mục run riêng, seed 42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="366" y="60" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b6" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;3. Kiểm tra ảnh&lt;/b&gt;&lt;br&gt;ảnh lỗi · trùng byte/pixel ·&lt;br&gt;trùng khác nhãn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="702" y="60" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-d7" value="Ảnh lỗi hoặc&lt;br&gt;trùng khác nhãn?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1038" y="55" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b8" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B71C1C&quot;&gt;&lt;b&gt;[BLOCKED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Dừng run&lt;/b&gt;: sửa dữ liệu, tạo run mới;&lt;br&gt;không âm thầm bỏ ảnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1018" y="240" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b9" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;4. Chia phân tầng 70/15/15&lt;/b&gt;&lt;br&gt;sau làm sạch, theo ảnh&lt;br&gt;split_manifest + hash" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1334" y="60" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b10" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;5. Augmentation chỉ train&lt;/b&gt;&lt;br&gt;offline 1 bản/ảnh: xoay ±8°, dịch ≤3%,&lt;br&gt;sáng 0.95–1.05; không flip/crop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1670" y="60" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b11" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;6. Manifest mẫu train&lt;/b&gt;&lt;br&gt;ảnh gốc + biến thể&lt;br&gt;parent hash" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="30" y="380" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b12" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;7. Trích CLS ViT&lt;/b&gt;&lt;br&gt;từ chính từng ảnh, cả biến thể&lt;br&gt;→ CNN và ViT cùng một ảnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="366" y="380" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b13" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;8. Cache CLS đã đối chiếu&lt;/b&gt;&lt;br&gt;hash ảnh đúng thứ tự,&lt;br&gt;processor, revision, môi trường" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="702" y="380" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b14" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;9. Class weights + loss&lt;/b&gt;&lt;br&gt;balanced, chỉ từ train, tách augmentation&lt;br&gt;0.7 focal + 0.3 CE theo từng mẫu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1038" y="380" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b15" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;10. Preflight&lt;/b&gt;&lt;br&gt;1 batch fit + lưu/nạp&lt;br&gt;cho cả 4 mô hình" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1404" y="380" width="290" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b16" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;11. Train 4 mô hình&lt;/b&gt;&lt;br&gt;CNN · ViT Head · CNN–ViT&lt;br&gt;Adaptive (mô hình chính)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1730" y="380" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b17" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;12. Adaptive: Stage A → B&lt;/b&gt;&lt;br&gt;A: ResNet50 đóng băng, 10 epoch, lr 2e-4&lt;br&gt;B: mở 60 layer cuối ResNet50, BatchNorm&lt;br&gt;đóng băng, 20 epoch, lr 5e-5 · AdamW" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="30" y="600" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b18" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;13. Best validation&lt;/b&gt;&lt;br&gt;macro F1 xuyên A/B&lt;br&gt;early stopping patience 7" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="466" y="600" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b19" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;14. Lưu và nạp lại&lt;/b&gt;&lt;br&gt;model.keras roundtrip&lt;br&gt;best.weights.h5 roundtrip" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="802" y="600" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b20" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;15. Test một lần&lt;/b&gt;&lt;br&gt;Adaptive chốt trước test&lt;br&gt;marker chống chạy lặp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1138" y="600" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b21" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;16. Lưu kết quả&lt;/b&gt;&lt;br&gt;metrics · predictions · confusion matrix&lt;br&gt;ROC · history · Grad-CAM ảnh thử" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL1-L3">
