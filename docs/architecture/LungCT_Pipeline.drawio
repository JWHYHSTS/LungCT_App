  <diagram id="PL-p2" name="2. Kiến trúc mô hình">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PL2-t1" value="&lt;b&gt;Trang 2 — Kiến trúc Adaptive AACNN–ViT và phạm vi Grad-CAM&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="2000" height="38" as="geometry" />
        </mxCell>
        <mxCell id="PL2-t2" value="Hai nhánh nhận CÙNG một ảnh. CNN: RGB 512×512; ViT: 224×224 qua processor, lấy CLS 768. ViT đóng băng." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b3" value="&lt;b&gt;Ảnh CT&lt;/b&gt;&lt;br&gt;JPEG/PNG&lt;br&gt;giải mã RGB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL2-L4" value="NHÁNH CNN — TensorFlow/Keras" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#E0F2F1;strokeColor=#00897B;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="110" width="1200" height="310" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b5" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Resize 512×512&lt;/b&gt;&lt;br&gt;(nearest)&lt;br&gt;RGB float32 [0,1]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L4">
          <mxGeometry x="20" y="70" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b6" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ResNetPreprocess&lt;/b&gt;&lt;br&gt;×255 → chuẩn hóa ImageNet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L4">
          <mxGeometry x="310" y="70" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b7" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ResNet50 (ImageNet)&lt;/b&gt;&lt;br&gt;avg pool → 2048&lt;br&gt;đích Grad-CAM: conv5_block3_out" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L4">
          <mxGeometry x="600" y="70" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b8" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Dense 512 ReLU&lt;/b&gt;&lt;br&gt;+ Dropout 0.25&lt;br&gt;→ cnn_token: Dense 256 (L2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L4">
          <mxGeometry x="910" y="70" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-L9" value="NHÁNH ViT — PyTorch/Transformers (đóng băng, không fine-tune)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#E0F2F1;strokeColor=#00897B;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="460" width="1200" height="310" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b10" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Resize 224×224&lt;/b&gt;&lt;br&gt;(nearest)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L9">
          <mxGeometry x="20" y="70" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b11" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ViTImageProcessor&lt;/b&gt;&lt;br&gt;đúng revision đã ghi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L9">
          <mxGeometry x="310" y="70" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b12" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ViT-B/16 in21k&lt;/b&gt;&lt;br&gt;google/vit-base-patch16-224-in21k&lt;br&gt;lấy CLS 768" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L9">
          <mxGeometry x="600" y="70" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-b13" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;LayerNorm → Dense 512&lt;/b&gt;&lt;br&gt;GELU + Dropout 0.25&lt;br&gt;→ vit_token: Dense 256 (L2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL2-L9">
          <mxGeometry x="910" y="70" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL2-e14" value="cùng một ảnh" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PL2-b3" target="PL2-b5">
