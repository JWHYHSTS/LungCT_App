        </mxCell>
        <mxCell id="PL3-N34" value="Định dạng đích và bộ thực thi chỉ chốt sau khảo sát; không chọn runtime chỉ vì chạy được phân loại. Mọi bước lượng tử hóa (FP16/int8) phải đo lại parity và chất lượng trên validation; không dùng test để chọn bản nén." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="PL3-L20">
