        <mxCell id="PL1-t1" value="&lt;b&gt;Trang 1 — Pipeline dữ liệu và huấn luyện (đối chiếu notebook LungCT_Reproduction_Improved v1.5)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
