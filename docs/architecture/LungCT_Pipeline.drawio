  <diagram id="PL-p3" name="3. Đóng gói và chuyển đổi">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1930" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PL3-t1" value="&lt;b&gt;Trang 3 — Đóng gói mô hình nguồn, ứng viên làm nhẹ và chuyển đổi cho điện thoại&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="2000" height="38" as="geometry" />
        </mxCell>
        <mxCell id="PL3-t2" value="Gói nguồn ≠ artifact mobile. Chỉ ghi mobile-ready khi có artifact, code tích hợp, parity và minh chứng thiết bị thật trên từng nền tảng." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PL3-L3" value="GÓI NGUỒN MÔ HÌNH — Colab / máy tính (notebook mục 16 và 21)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#E0F2F1;strokeColor=#00897B;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="2320" height="480" as="geometry" />
        </mxCell>
        <mxCell id="PL3-d4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Không smoke ·&lt;br&gt;Grad-CAM ảnh thử PASS ·&lt;br&gt;roundtrip PASS?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;" vertex="1" parent="PL3-L3">
          <mxGeometry x="20" y="60" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b5" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B71C1C&quot;&gt;&lt;b&gt;[BLOCKED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Dừng xuất gói&lt;/b&gt;&lt;br&gt;xử lý lỗi trước" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="20" y="290" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b6" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;LungCT_Primary_&amp;lt;RUN_ID&amp;gt;.zip&lt;/b&gt; + .sha256&lt;br&gt;fusion/model.keras · fusion/best.weights.h5&lt;br&gt;vit/ (trọng số + processor, đúng revision)&lt;br&gt;custom_layers.py · predict.py&lt;br&gt;config, manifest, metrics, HUONG_DAN_SU_DUNG" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="370" y="50" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b7" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Kiểm tra tiến trình độc lập&lt;/b&gt;&lt;br&gt;CPU, Hugging Face offline,&lt;br&gt;chỉ file cục bộ, 1 ảnh thử&lt;br&gt;→ offline_parity.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="870" y="50" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b8" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ứng viên làm nhẹ (giữ kiến trúc)&lt;/b&gt;&lt;br&gt;lưu ViT bằng FP16, fusion giữ nguyên;&lt;br&gt;CPU vẫn tính float32;&lt;br&gt;FP32 là đối chứng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="1290" y="50" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="PL3-d9" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Validation: macro F1&lt;br&gt;giảm ≤ 0.01 và&lt;br&gt;khớp nhãn ≥ 98%?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;" vertex="1" parent="PL3-L3">
          <mxGeometry x="1750" y="50" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b10" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;LungCT_LightCandidate&lt;/b&gt; zip&lt;br&gt;PASS_VALIDATION_ONLY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="2040" y="50" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b11" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Giữ gói FP32;&lt;br&gt;lưu lý do FAIL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="2040" y="230" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="PL3-N12" value="&lt;b&gt;mobile_ready = false.&lt;/b&gt; ZIP, .keras, .h5 KHÔNG đồng nghĩa chạy được trên điện thoại. Ứng viên FP16 chủ yếu giảm dung lượng lưu/truyền; chưa đo RAM/latency điện thoại, không kết luận nhanh hơn; chưa có test độc lập cho ứng viên. Gói nguồn lưu ngoài Git, tham chiếu từ ai/runs/RUN-ID kèm checksum." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="PL3-L3">
          <mxGeometry x="370" y="310" width="1640" height="150" as="geometry" />
        </mxCell>
