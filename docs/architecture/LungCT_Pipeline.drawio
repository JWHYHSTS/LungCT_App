        <mxCell id="PL3-L20" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt; CHUYỂN ĐỔI CHO ĐIỆN THOẠI [MOB-01, MOB-02] — thực hiện và minh chứng riêng Android, iOS" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="2320" height="600" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b21" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;1. Khảo sát runtime&lt;/b&gt;&lt;br&gt;toán tử hai nhánh, gradient/activation cho CAM, RAM, license" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
