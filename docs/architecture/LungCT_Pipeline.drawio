        <mxCell id="PL3-L48" value="KIỂM TRA PIPELINE ẢNH THỬ — notebook mục 19 (không phải đánh giá dataset)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#E0F2F1;strokeColor=#00897B;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
