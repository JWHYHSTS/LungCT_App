        <mxCell id="PL3-b23" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B71C1C&quot;&gt;&lt;b&gt;[BLOCKED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ghi bằng chứng, xin Jim&lt;br&gt;quyết định; không tự đổi&lt;br&gt;kiến trúc mô hình" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="300" y="290" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b24" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B26A00&quot;&gt;&lt;b&gt;[CHƯA CHỐT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;2. Chuyển đổi cả pipeline&lt;/b&gt;&lt;br&gt;tiền xử lý + ViT + fusion + CAM&lt;br&gt;định dạng: TFLite/int8 hay khác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=8 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="620" y="60" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b25" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;3. Parity nhiều ảnh&lt;/b&gt;&lt;br&gt;so gói nguồn, cùng tiền xử lý;&lt;br&gt;tiêu chí chốt trước" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="970" y="60" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL3-d26" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Parity đạt?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;" vertex="1" parent="PL3-L20">
          <mxGeometry x="1270" y="55" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b27" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;4. Grad-CAM thật&lt;/b&gt;&lt;br&gt;trên thiết bị, cùng target layer và lớp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="1520" y="60" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b28" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;5. Benchmark&lt;/b&gt;&lt;br&gt;cold/warm, thời gian CAM, RAM, dung lượng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="1790" y="60" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b29" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;6. Tích hợp app&lt;/b&gt;&lt;br&gt;assets/models/&amp;lt;nền tảng&amp;gt; + platform/inference" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="2060" y="60" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b30" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;7. Test thiết bị&lt;/b&gt;&lt;br&gt;tắt Internet, ngắt USB, tắt Metro và máy tính" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="2060" y="300" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PL3-d31" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Đủ evidence cho&lt;br&gt;phân loại và CAM?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;" vertex="1" parent="PL3-L20">
          <mxGeometry x="1700" y="285" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b32" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ghi mobile-ready&lt;/b&gt;&lt;br&gt;cho nền tảng đó; Android và iOS&lt;br&gt;đánh giá riêng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
          <mxGeometry x="1280" y="310" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="PL3-b33" value="Báo phần đạt riêng; chưa ghi hoàn thành tích hợp ngoại tuyến" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="PL3-L20">
