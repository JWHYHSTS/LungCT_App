  </diagram>
  <diagram id="PL-p5" name="5. So sánh local và server">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PL5-t1" value="&lt;b&gt;Trang 5 — Hai nguồn suy luận: local trên điện thoại và server FastAPI (cần đo, không khẳng định trước)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="2000" height="38" as="geometry" />
        </mxCell>
        <mxCell id="PL5-t2" value="Thay cho phần “ưu điểm / hạn chế” tuyệt đối của bản cũ (PA1, PA2). Cả hai đều chưa triển khai." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b3" value="&lt;b&gt;Tiêu chí&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b4" value="&lt;b&gt;Suy luận cục bộ trên điện thoại&lt;/b&gt; — yêu cầu bắt buộc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="960" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b5" value="&lt;b&gt;Suy luận trên máy chủ FastAPI&lt;/b&gt; — đề xuất bổ trợ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="110" width="960" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b6" value="&lt;b&gt;Kết nối khi phân tích&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b7" value="Không cần Internet khi đã tích hợp artifact và runtime trên máy." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="190" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b8" value="Cần mạng tới máy chủ trong lúc phân tích." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="190" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b9" value="&lt;b&gt;Ảnh CT khi phân tích&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b10" value="Không phải gửi ảnh đi để phân tích. Ảnh vẫn có thể đồng bộ lên Firebase theo thiết kế (phạm vi chưa chốt); an toàn phụ thuộc mã hóa thiết bị và quản lý khóa." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="305" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b11" value="Ảnh gửi qua HTTPS; cần kiểm soát quyền, thời gian lưu và xóa trên máy chủ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="305" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b12" value="&lt;b&gt;Tốc độ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b13" value="Phụ thuộc thiết bị, runtime và kích thước hai nhánh (ResNet50 + ViT-B/16) — phải benchmark trên Android và iOS." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b14" value="Phụ thuộc cấu hình máy chủ, mạng, hàng đợi job — phải đo; số đo Colab không thay số đo thực tế." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="420" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b15" value="&lt;b&gt;Chi phí&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="535" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b16" value="Không phát sinh chi phí máy chủ cho mỗi lần suy luận; tốn công chuyển đổi và kiểm thử hai nền tảng." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="535" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b17" value="Có chi phí vận hành; mức cụ thể chưa ước tính vì chưa chọn hạ tầng." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="535" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b18" value="&lt;b&gt;Dung lượng ứng dụng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b19" value="Tăng theo artifact hai nhánh; chưa đo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="650" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b20" value="Ứng dụng không chứa mô hình." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="650" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b21" value="&lt;b&gt;Cập nhật mô hình&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b22" value="Thường cần bản cài mới hoặc cơ chế tải artifact có kiểm tra checksum — chưa chốt." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="765" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b23" value="Cập nhật phía máy chủ; vẫn phải quản lý modelVersion và tương thích hợp đồng với app." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="765" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b24" value="&lt;b&gt;Grad-CAM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b25" value="Phải chạy thật trên runtime di động (gradient/activation) — chưa kiểm chứng; rủi ro chính khi chọn runtime." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="880" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b26" value="Dùng lại pipeline Python của notebook (có code, chưa chạy trên dữ liệu thật)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="880" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b27" value="&lt;b&gt;Trạng thái&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=14;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="995" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b28" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Chưa làm — bắt buộc trước nghiệm thu ngoại tuyến." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="995" width="960" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PL5-b29" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D4037&quot;&gt;&lt;b&gt;[CHƯA LÀM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Chưa làm — triển khai khi cần bổ trợ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;dashPattern=12 4 2 4;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
