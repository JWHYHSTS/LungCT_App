        <mxCell id="PL1-e38" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PL1-b20" target="PL1-b21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PL1-N39" value="&lt;b&gt;Đang tắt theo cấu hình&lt;/b&gt;&lt;br&gt;• MixUp: MIXUP_ALPHA = 0 (chưa triển khai)&lt;br&gt;• Augmentation online CNN/fusion: CNN_AUGMENT = False, FUSION_AUGMENT = False&lt;br&gt;• Bản cũ ghi “lật, thu phóng, MixUp” đã sửa." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="30" y="800" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-N40" value="&lt;b&gt;Giới hạn&lt;/b&gt;&lt;br&gt;• Chia theo ảnh, chưa chứng minh độc lập bệnh nhân [DATA-01].&lt;br&gt;• Chưa kiểm tra near-duplicate.&lt;br&gt;• Số ảnh sau làm sạch lấy từ dataset_inventory / split_summary; không mặc định 1.097." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="796" y="800" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-N41" value="&lt;b&gt;Vai trò ba tập&lt;/b&gt;&lt;br&gt;• Train: học trọng số (kể cả biến thể augmentation).&lt;br&gt;• Validation: chọn checkpoint bằng macro F1.&lt;br&gt;• Test: đánh giá một lần mô hình đã chốt; không dùng để tối ưu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="PL1-L3">
          <mxGeometry x="1562" y="800" width="728" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PL1-b42" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;[CÓ CODE · CHƯA CHẠY THẬT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Đầu ra mỗi run&lt;/b&gt; (ai/runs/RUN-ID; tệp lớn lưu ngoài Git): config · environment · pip-freeze · dataset_inventory · duplicates · split_manifest + split_summary · augmentation_summary · training_samples_manifest · class_weights · preflight · history · best.weights.h5 · model.keras · roundtrip · validation/test metrics, predictions, confusion matrix, ROC · gradcam_status · artifact_manifest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;dashed=1;dashPattern=2 3;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PL1-N43" value="&lt;b&gt;Trạng thái kiểm chứng&lt;/b&gt;: notebook v1.5 mới qua kiểm tra kỹ thuật bằng dữ liệu tổng hợp nhỏ. Chưa chạy toàn bộ trên dữ liệu thật, chưa có accuracy/F1/latency. Không dùng số liệu lịch sử hoặc số liệu smoke trong báo cáo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
