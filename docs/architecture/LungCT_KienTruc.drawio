        <mxCell id="KT2-L33" value="MÁY CHỦ FastAPI — đề xuất, chưa triển khai" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
