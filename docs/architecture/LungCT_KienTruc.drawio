        <mxCell id="KT2-b47" value="&lt;b&gt;Cloud Messaging&lt;/b&gt;&lt;br&gt;thông báo nội dung chung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT2-L43">
