        </mxCell>
        <mxCell id="KT3-b39" value="&lt;b&gt;Đồng bộ (sync/)&lt;/b&gt;&lt;br&gt;đẩy outbox rồi kéo thay đổi;&lt;br&gt;operationId chống gửi trùng, revision,&lt;br&gt;xử lý conflict, tombstone khi xóa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
          <mxGeometry x="890" y="40" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b40" value="&lt;b&gt;Cập nhật trạng thái cục bộ&lt;/b&gt;&lt;br&gt;thời điểm kiểm tra gần nhất" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
          <mxGeometry x="1270" y="55" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b41" value="&lt;b&gt;Chặn phiên&lt;/b&gt;&lt;br&gt;đăng xuất, vô hiệu phiên,&lt;br&gt;dừng đồng bộ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
          <mxGeometry x="890" y="200" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b42" value="&lt;b&gt;Xử lý dữ liệu cục bộ khi bị khóa&lt;/b&gt;&lt;br&gt;• dọn cache đã đồng bộ theo chính sách&lt;br&gt;• giữ dirty draft + phần phụ thuộc ở trạng thái khóa&lt;br&gt;• không xóa sửa đổi chưa đồng bộ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
          <mxGeometry x="1270" y="190" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b43" value="&lt;b&gt;Lỗi kết nối / máy chủ&lt;/b&gt;&lt;br&gt;không kết luận bị khóa; giữ outbox,&lt;br&gt;thử lại có giới hạn (backoff)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
          <mxGeometry x="890" y="345" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-N44" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B26A00&quot;&gt;&lt;b&gt;[CHƯA CHỐT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Điểm còn mở&lt;/b&gt;&lt;br&gt;• Admin mở khóa lại và xử lý draft đã giữ.&lt;br&gt;• Quan hệ hoàn tất cục bộ ↔ xác nhận trung tâm.&lt;br&gt;• Quy tắc giải quyết conflict chi tiết." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="KT3-L34">
