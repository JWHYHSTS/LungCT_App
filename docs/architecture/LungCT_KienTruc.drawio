        <mxCell id="KT1-e217" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;" edge="1" parent="KT1-F181" source="KT1-lc215" target="KT1-ld216">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KT1-t218" value="Đứt: trao đổi qua mạng" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="KT1-F181">
          <mxGeometry x="330" y="224" width="176" height="24" as="geometry" />
        </mxCell>
        <mxCell id="KT1-N219" value="&lt;b&gt;Không commit mặc định&lt;/b&gt;&lt;br&gt;• Dataset, trọng số lớn, gói ZIP mô hình&lt;br&gt;• Mật khẩu, token, service account, khóa ký&lt;br&gt;• Dữ liệu bệnh nhân thật&lt;br&gt;Lưu ngoài Git, ghi đường dẫn truy cập + checksum trong manifest." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1860" y="490" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="KT1-N220" value="&lt;b&gt;Tách mô hình nguồn và artifact mobile&lt;/b&gt;&lt;br&gt;• Nguồn: ai/runs/RUN-ID + gói LungCT_Primary (fusion Keras + ViT/processor).&lt;br&gt;• Mobile: mobile/assets/models/android | ios — chỉ sau chuyển đổi + parity.&lt;br&gt;• ZIP/.keras/.h5 không đồng nghĩa mobile-ready." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1860" y="760" width="520" height="210" as="geometry" />
        </mxCell>
        <mxCell id="KT1-N221" value="&lt;b&gt;Đường dẫn báo cáo thống nhất&lt;/b&gt;&lt;br&gt;reports/android/ và reports/ios/ ở gốc kho mã (theo Quy định Antigravity v1.1). Thay cho docs/reports/… ở bản cũ; không giữ hai nơi cùng loại dữ liệu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1860" y="990" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="KT1-N222" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B26A00&quot;&gt;&lt;b&gt;[CHƯA CHỐT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Lockfile&lt;/b&gt;: mobile (package manager chưa chốt) và backend (pip-tools/uv/poetry… chưa chốt). Bắt buộc có lockfile khi đã chọn công cụ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1210" width="520" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="KT-p2" name="2. Kiến trúc thành phần">
