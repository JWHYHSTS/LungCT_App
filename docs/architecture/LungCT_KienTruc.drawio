        </mxCell>
        <mxCell id="KT2-N50" value="&lt;b&gt;Nguyên tắc ngoại tuyến&lt;/b&gt;: luồng local không gọi API ngầm khi nghiệm thu ngoại tuyến và không phụ thuộc Metro, USB hoặc máy tính. Firebase và FastAPI chỉ dùng cho chức năng trực tuyến; FastAPI chạy trên máy chủ, không nằm trong điện thoại." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
