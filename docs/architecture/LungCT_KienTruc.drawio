        <mxCell id="KT2-t1" value="&lt;b&gt;Trang 2 — Kiến trúc thành phần và hai nguồn phân tích (local / server)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1900" height="38" as="geometry" />
        </mxCell>
        <mxCell id="KT2-t2" value="Local chạy hoàn toàn trên điện thoại; server qua HTTPS → FastAPI → job. Hai nguồn dùng chung hợp đồng dữ liệu, class order và modelVersion." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
