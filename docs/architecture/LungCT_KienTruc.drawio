        <mxCell id="KT3-t1" value="&lt;b&gt;Trang 3 — Đăng nhập, xác thực cục bộ và đồng bộ khi có mạng trở lại&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1900" height="38" as="geometry" />
        </mxCell>
        <mxCell id="KT3-t2" value="Lần đầu trên thiết bị cần mạng và tài khoản đã được duyệt; sau đó xác thực cục bộ an toàn, không lưu mật khẩu nguyên văn, không giới hạn 24 giờ." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="KT3-L3" value="ĐĂNG NHẬP — kiểm tra kết nối, rồi xác thực trực tuyến hoặc cục bộ" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="2320" height="640" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b4" value="&lt;b&gt;Dịch vụ xác thực&lt;/b&gt;&lt;br&gt;Firebase Auth / FastAPI&lt;br&gt;(phân vai chưa chốt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="20" y="60" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b5" value="&lt;b&gt;Nhập email + mật khẩu&lt;/b&gt;&lt;br&gt;màn hình đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="20" y="250" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="KT3-d6" value="Có kết nối&lt;br&gt;mạng?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="KT3-L3">
          <mxGeometry x="300" y="235" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b7" value="&lt;b&gt;Xác thực trực tuyến&lt;/b&gt;&lt;br&gt;kiểm tra tài khoản,&lt;br&gt;trạng thái duyệt/khóa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="560" y="60" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-d8" value="Kết quả kiểm tra&lt;br&gt;trực tuyến?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="KT3-L3">
          <mxGeometry x="870" y="45" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b9" value="&lt;b&gt;Thiết lập xác thực cục bộ&lt;/b&gt;&lt;br&gt;bộ kiểm chứng băm (KDF) + khóa&lt;br&gt;trong secure-storage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1170" y="60" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b10" value="&lt;b&gt;Từ chối&lt;/b&gt;&lt;br&gt;chờ duyệt hoặc bị khóa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1170" y="190" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b11" value="&lt;b&gt;Vào ứng dụng&lt;/b&gt;&lt;br&gt;chế độ trực tuyến&lt;br&gt;hoặc ngoại tuyến" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=3;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1530" y="240" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b12" value="&lt;b&gt;Sử dụng&lt;/b&gt;: AI chạy trên điện thoại, dữ liệu cục bộ;&lt;br&gt;đồng bộ khi có mạng và tài khoản hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1840" y="240" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-d13" value="Thiết bị đã thiết lập&lt;br&gt;cho tài khoản này?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="KT3-L3">
          <mxGeometry x="560" y="420" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b14" value="&lt;b&gt;Chưa thể đăng nhập&lt;/b&gt;&lt;br&gt;lần đầu trên thiết bị cần mạng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="20" y="450" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b15" value="&lt;b&gt;Xác thực cục bộ&lt;/b&gt;&lt;br&gt;so khớp bộ kiểm chứng băm;&lt;br&gt;không lưu mật khẩu nguyên văn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="870" y="440" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT3-d16" value="Mật khẩu&lt;br&gt;đúng?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1170" y="425" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b17" value="&lt;b&gt;Từ chối&lt;/b&gt;, cho nhập lại&lt;br&gt;(giới hạn số lần sai: chưa chốt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1430" y="450" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="KT3-N18" value="&lt;b&gt;Quy tắc&lt;/b&gt;&lt;br&gt;• Lần đầu: cần mạng + tài khoản đã được admin duyệt.&lt;br&gt;• Khóa bảo vệ bằng kho an toàn của hệ điều hành.&lt;br&gt;• Không giới hạn ngoại tuyến 24 giờ.&lt;br&gt;• Ngoại tuyến chỉ biết trạng thái ở lần kiểm tra gần nhất.&lt;br&gt;• Chưa chốt: thuật toán băm; đổi mật khẩu khi thiết bị khác ngoại tuyến; nhiều tài khoản/thiết bị." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="KT3-L3">
          <mxGeometry x="1700" y="410" width="590" height="210" as="geometry" />
        </mxCell>
