        <mxCell id="KT2-N18" value="&lt;b&gt;Trạng thái tách riêng&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;classificationStatus&lt;/b&gt;:&lt;br&gt;PENDING · RUNNING · PASS · FAIL&lt;br&gt;&lt;br&gt;&lt;b&gt;explanationStatus&lt;/b&gt; (CAM):&lt;br&gt;PENDING · PASS · ZERO_CAM · UNAVAILABLE · FAIL&lt;br&gt;&lt;br&gt;PASS/ZERO_CAM/UNAVAILABLE/FAIL theo notebook; PENDING/RUNNING là đề xuất cho app.&lt;br&gt;&lt;br&gt;CAM lỗi: giữ scores, báo thiếu CAM, cho thử lại đúng modelVersion; không dùng heatmap giả." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="KT2-L3">
