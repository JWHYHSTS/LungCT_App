        <mxCell id="KT2-b34" value="&lt;b&gt;routers/ + schemas/&lt;/b&gt;&lt;br&gt;token, quyền chủ sở hữu&lt;br&gt;bytes/MIME/kích thước" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT2-L33">
          <mxGeometry x="20" y="50" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT2-b35" value="&lt;b&gt;jobs/&lt;/b&gt;&lt;br&gt;job phân tích bền vững&lt;br&gt;idempotency · hủy · retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT2-L33">
          <mxGeometry x="310" y="50" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT2-b36" value="&lt;b&gt;inference/&lt;/b&gt;&lt;br&gt;nạp mô hình một lần&lt;br&gt;tiền xử lý → CLS → fusion → CAM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT2-L33">
          <mxGeometry x="600" y="50" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT2-e37" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="KT2-b34" target="KT2-b35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KT2-e38" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="KT2-b35" target="KT2-b36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KT2-N39" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B26A00&quot;&gt;&lt;b&gt;[CHƯA CHỐT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;API đề xuất&lt;/b&gt; — ví dụ POST /v1/analysis-jobs (gửi ảnh) → GET /v1/analysis-jobs/{id} (lấy kết quả). Tên/phiên bản endpoint, định dạng heatmap trả về (ma trận thô hay ảnh overlay) và cách truyền CAM: chưa chốt. Thay cho “POST /predict” ở bản cũ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="KT2-L33">
          <mxGeometry x="20" y="190" width="840" height="120" as="geometry" />
        </mxCell>
        <mxCell id="KT2-b40" value="&lt;b&gt;Mô hình trên máy chủ&lt;/b&gt;: dùng gói nguồn LungCT_Primary (fusion Keras + ViT/processor + custom_layers). Cùng class order, tiền xử lý và modelVersion với bản điện thoại." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT2-L33">
          <mxGeometry x="20" y="330" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KT2-b41" value="&lt;b&gt;Phản hồi&lt;/b&gt; theo cùng hợp đồng kết quả; executionSource = server. Lỗi CAM không xóa scores. Kết quả cũ bị chặn khi ảnh đã thay hoặc tài khoản mất quyền." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT2-L33">
