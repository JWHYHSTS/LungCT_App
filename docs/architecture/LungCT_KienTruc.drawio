        <mxCell id="KT4-t1" value="&lt;b&gt;Trang 4 — Phân chia hai báo cáo, kiểm thử và chu trình sau mỗi lệnh Antigravity&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;align=left;verticalAlign=middle;" vertex="1" parent="1">
