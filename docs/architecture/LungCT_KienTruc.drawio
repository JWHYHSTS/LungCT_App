        <mxCell id="KT3-L34" value="KHI CÓ MẠNG TRỞ LẠI — kiểm tra trạng thái tài khoản trước khi đồng bộ" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;rounded=1;arcSize=2;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="2320" height="480" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b35" value="&lt;b&gt;Phát hiện có mạng&lt;/b&gt;&lt;br&gt;thiết bị đang ngoại tuyến" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
          <mxGeometry x="20" y="60" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="KT3-b36" value="&lt;b&gt;Kiểm tra trạng thái&lt;/b&gt;&lt;br&gt;tài khoản, trước mọi&lt;br&gt;thao tác đồng bộ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="KT3-L34">
